# NeoForge OBJ material slots; Ka=1 gives fullbright only to glow masks.
newmtl containment_cap_glow
Ka 1 1 1
Kd 1 1 1
Ks 0 0 0
d 1
illum 2
map_Kd #containment_cap_glow

